# SecondCycle — environment variables.
# Copy to .env.local and fill in. .env.local is never committed.

# --- Database (Neon) ------------------------------------------------------
# App queries use the POOLED connection string (host contains "-pooler").
# drizzle-kit migrations use the DIRECT/UNPOOLED string (same host, no "-pooler").
# Get both from the Neon dashboard → your branch → Connection Details.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth.js (next-auth v5) ----------------------------------------------
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=
# Canonical site URL. Local: http://localhost:3000  Prod: https://www.secondcycle.ro
AUTH_URL=http://localhost:3000
# Google OAuth (Google Cloud Console → Credentials → OAuth client).
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://www.secondcycle.ro/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) -------------------------------------------------------
# RESEND_API_KEY from resend.com → API Keys. EMAIL_FROM must be a verified domain.
RESEND_API_KEY=
EMAIL_FROM="SecondCycle <no-reply@secondcycle.ro>"

# --- Images (Cloudflare R2, S3-compatible) --------------------------------
# From Cloudflare dashboard → R2. Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for serving objects (R2 public bucket or a custom domain).
R2_PUBLIC_URL=

# --- Cron -----------------------------------------------------------------
# Shared secret required on every /api/cron/* request (Authorization: Bearer ...).
# Generate with `openssl rand -hex 32`. Set the same value in Vercel Cron.
CRON_SECRET=

# --- Seed admin -----------------------------------------------------------
# `npm run seed` creates/ensures this admin user (idempotent).
ADMIN_EMAIL=
ADMIN_PASSWORD=
